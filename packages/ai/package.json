{
  "name": "@capsicum/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hosted": {
      "types": "./src/hosted.ts",
      "import": "./dist/hosted.js",
      "default": "./dist/hosted.js"
    },
    "./evaluation": {
      "types": "./src/evaluation.ts",
      "import": "./dist/evaluation.js",
      "default": "./dist/evaluation.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-imports.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "ai": "6.0.224",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "files": [
    "dist"
  ]
}
