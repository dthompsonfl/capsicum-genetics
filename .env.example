# DEVELOPMENT-ONLY example. Production Compose fails closed unless every required value is supplied.
NODE_ENV=development
APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
# Immutable 40- or 64-character hexadecimal source revision used in scientific exports.
# CI should inject the exact commit SHA; never use branch names or mutable tags.
APP_RELEASE_SHA=

# First-owner bootstrap is closed unless this digest is configured. Generate a
# 32+ byte random token, deliver the raw token out of band to the intended
# owner, and store only: printf '%s' "$TOKEN" | sha256sum
BOOTSTRAP_TOKEN_SHA256=

# Use distinct roles. Never run the web or worker with migration-owner authority.
MIGRATION_DATABASE_URL=postgresql://capsicum_admin:replace-admin-password@localhost:5432/capsicum
DATABASE_ADMIN_URL=postgresql://capsicum_admin:replace-admin-password@localhost:5432/capsicum
DATABASE_URL=postgresql://capsicum_runtime_login:replace-runtime-password@localhost:5432/capsicum
WORKER_DATABASE_URL=postgresql://capsicum_worker_login:replace-worker-password@localhost:5432/capsicum
CAPSICUM_ADMIN_DB_PASSWORD=replace-admin-password
CAPSICUM_RUNTIME_DB_PASSWORD=replace-runtime-password
CAPSICUM_WORKER_DB_PASSWORD=replace-worker-password

# Generate independent random values of at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_DERIVATION_SECRET=replace-with-an-independent-32-character-secret
NETWORK_FINGERPRINT_SECRET=replace-with-an-independent-32-character-secret
ABUSE_CONTROL_SECRET=replace-with-an-independent-32-character-secret
MFA_ENCRYPTION_KEY=replace-with-64-lowercase-hex-characters
REQUIRE_PRIVILEGED_MFA=false
TRUSTED_PROXY_HOPS=0

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=capsicum-local
S3_ACCESS_KEY_ID=capsicum
S3_SECRET_ACCESS_KEY=replace-this-local-development-secret
S3_FORCE_PATH_STYLE=true

# disabled is the production-safe default. mock is test/local only.
AI_PROVIDER=disabled
AI_MODEL_ID=openai/gpt-5-mini
AI_GATEWAY_API_KEY=
ENABLE_HOSTED_AI=false
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=1500
ENABLE_LEARNED_VISION=false
ENABLE_RESEARCH_MODELS=false

# local is development-only. Production requires resend plus a verified sender.
DELIVERY_ADAPTER=local
LOCAL_DELIVERY_SPOOL=.runtime/delivery
DELIVERY_FROM_EMAIL=
RESEND_API_KEY=

# Malware inspection. The Compose stack uses the internal ClamAV service by default.
MEDIA_SCANNER_HOST=clamav
MEDIA_SCANNER_PORT=3310
# Optional mutually exclusive governed HTTP scanner adapter.
MEDIA_SCANNER_URL=
MEDIA_SCANNER_BEARER_TOKEN=
AI_INPUT_COST_MICROUNITS_PER_MILLION_TOKENS=0
AI_OUTPUT_COST_MICROUNITS_PER_MILLION_TOKENS=0
AI_MAX_COST_MICROUNITS_PER_REQUEST=0
WORKER_MAX_MEDIA_BYTES=26214400
WORKER_MEDIA_CONCURRENCY=1
PYTHON_VISION_MEMORY_MB=512
PYTHON_VISION_CPU_SECONDS=20
