{
  "name": "capsicum-breeding-intelligence",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "validate": "pnpm validate:lockfile && pnpm validate:manifests && pnpm validate:environment && pnpm validate:toolchain && pnpm validate:workspace-dependencies && pnpm validate:next-contracts && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:migrator && pnpm build && pnpm validate:catalog && pnpm validate:smoke && pnpm test:python && pnpm validate:repository",
    "validate:catalog": "python3 scripts/import_catalog.py --check",
    "validate:repository": "python3 scripts/validate_repository.py",
    "test:python": "python3 -m pytest apps/worker-python/tests -q",
    "db:migrate": "pnpm --filter @capsicum/database migrate",
    "validate:full": "pnpm validate && pnpm db:migrate",
    "db:seed-catalog": "pnpm --filter @capsicum/database seed:catalog",
    "db:provision-roles": "pnpm --filter @capsicum/database provision:roles",
    "worker:node": "pnpm --filter @capsicum/worker-node start",
    "compose:up": "docker compose --env-file .env.local -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.dev.yml --profile application up --build",
    "compose:down": "docker compose --env-file .env.local -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.dev.yml --profile application down",
    "db:verify-authority": "pnpm --filter @capsicum/database verify:authority",
    "backup:create": "bash infra/backup/backup.sh",
    "backup:restore-test": "bash infra/backup/restore-test.sh",
    "clean": "node scripts/clean.mjs",
    "build:packages": "turbo build --filter=./packages/**",
    "build:web": "turbo build --filter=@capsicum/web",
    "build:worker": "turbo build --filter=@capsicum/worker-node",
    "start:worker": "node apps/worker-node/dist/worker.js",
    "verify:compiled": "node scripts/ci/verify-compiled-artifacts.mjs",
    "verify:standalone": "node scripts/ci/verify-standalone.mjs",
    "validate:runtime-artifacts": "pnpm verify:compiled && pnpm verify:standalone",
    "validate:syntax": "node scripts/ci/parse-typescript.mjs",
    "generate:manifests": "node scripts/generate-migration-manifest.mjs && node scripts/generate-routine-manifest.mjs",
    "validate:manifests": "node scripts/generate-migration-manifest.mjs --check && node scripts/generate-routine-manifest.mjs --check",
    "test:migrator": "pnpm --filter @capsicum/database test:migrator",
    "validate:v6-smoke": "node scripts/ci/run-v6-runtime-smoke.mjs",
    "evidence:release": "node scripts/ci/generate-release-evidence.mjs",
    "validate:environment": "node scripts/ci/check-environment-contracts.mjs",
    "validate:genetics-smoke": "node scripts/ci/run-genetics-runtime-smoke.mjs",
    "validate:lockfile": "node scripts/ci/check-lockfile.mjs",
    "validate:auth-smoke": "node scripts/ci/run-auth-runtime-smoke.mjs",
    "validate:smoke": "pnpm validate:auth-smoke && pnpm validate:genetics-smoke && pnpm validate:lab-export-smoke && pnpm validate:v6-smoke",
    "test:postgres": "pnpm --filter @capsicum/application test:postgres && pnpm --filter @capsicum/database verify:v6-integration && pnpm --filter @capsicum/database verify:migration-atomicity",
    "test:e2e": "pnpm --filter @capsicum/web test:e2e",
    "test:e2e:accessibility": "pnpm --filter @capsicum/web test:e2e:accessibility",
    "test:storage-integration": "pnpm --filter @capsicum/storage test:integration && pnpm --filter @capsicum/worker-node test:integration",
    "compose:smoke": "node scripts/ci/run-compose-smoke.mjs",
    "validate:lab-export-smoke": "node scripts/ci/run-laboratory-export-smoke.mjs",
    "validate:workspace-dependencies": "node scripts/ci/check-workspace-dependencies.mjs",
    "validate:toolchain": "node scripts/ci/check-toolchain-alignment.mjs",
    "validate:next-contracts": "node scripts/ci/check-next-app-contracts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/node": "24.3.0",
    "eslint": "9.32.0",
    "eslint-config-next": "16.2.11",
    "prettier": "3.6.2",
    "turbo": "2.9.14",
    "typescript": "5.9.2",
    "vitest": "3.2.6"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
